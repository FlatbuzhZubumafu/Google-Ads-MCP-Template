# ── Required ────────────────────────────────────────────────────────────
# Google Ads API developer token (Google Ads UI > Tools & Settings > API Center,
# requires a manager account).
GOOGLE_ADS_DEVELOPER_TOKEN=

# ── Remote mode (claude.ai custom connector / any HTTP MCP client) ──────
# OAuth 2.0 Web application client from Google Cloud Console.
# Setting both enables streamable-http transport with Google sign-in:
# each connecting user authenticates with their own Google account.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
# Public URL of this server once deployed (e.g. https://ads-mcp-xyz.a.run.app)
GOOGLE_ADS_MCP_BASE_URL=http://localhost:8080

# ── Local mode (stdio, e.g. Claude Code / Claude Desktop) ───────────────
# Option A: leave everything below unset and use Application Default
#   Credentials: gcloud auth application-default login --scopes=https://www.googleapis.com/auth/adwords,https://www.googleapis.com/auth/cloud-platform
# Option B: a pre-generated OAuth refresh token:
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────
# Manager (MCC) account id to authenticate through, digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Set to true to disable all mutation tools (monitoring only).
GOOGLE_ADS_MCP_READ_ONLY=

# Force HTTP transport without OAuth (trusted networks only — the
# endpoint is otherwise unauthenticated).
# GOOGLE_ADS_MCP_TRANSPORT=http

# Port for HTTP transport (Cloud Run sets this automatically).
# PORT=8080
